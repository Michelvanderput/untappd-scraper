# ===========================================
# BeerMenu / Untappd Scraper – Environment
# ===========================================
# Kopieer naar .env en vul de waarden in.
# .env wordt niet gecommit (staat in .gitignore).

# ---- Live register (Surprise-pagina: laatste 10 verrassingen) ----
# Upstash Redis (gratis tier): https://console.upstash.com/
# Zonder deze variabelen werkt de app gewoon; het live register toont dan "Nog geen verrassingen gedeeld".
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# ---- Scraper (lokaal / GitHub Actions) ----
# Optioneel: contact voor User-Agent (bijv. jouw@email.nl)
# SCRAPER_CONTACT_EMAIL=
